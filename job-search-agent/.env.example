# Copy this file to .env and fill in real values. Never commit .env itself.
#
# The primary job source (Indeed) is accessed through the Indeed MCP tool
# available directly inside Claude Code — no API key is required for that
# path. The variables below are placeholders for optional future sources
# and integrations mentioned in the roadmap (LinkedIn, Greenhouse, Lever,
# notifications). Leave unset until you actually wire one up.

# --- Future job sources (not yet implemented) ---
# LINKEDIN_SESSION_COOKIE=
# GREENHOUSE_API_KEY=
# LEVER_API_KEY=

# --- Optional notification integrations ---
# SLACK_WEBHOOK_URL=
# NOTIFICATION_EMAIL=

# --- Database override (defaults to job-search-agent/data/jobs.db) ---
# JOB_SEARCH_DB_PATH=/absolute/path/to/jobs.db
